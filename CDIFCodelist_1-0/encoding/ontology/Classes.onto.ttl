  rdfs:label "hasTopConcept_Concept";
  skos:altLabel "ConceptScheme_hasTopConcept_Concept";
  rdfs:comment "https://www.w3.org/TR/skos-reference/#hasTopConcept"@en;
  rdfs:domain skos:ConceptScheme;
