# class Concept
# based on the UML class SKOS::Classes::Concept
skos:Concept
  a rdfs:Class, owl:Class, ucmis:Class;
  rdfs:label "Concept";
  rdfs:comment "Definition\n==========\nThe class skos:Concept is the class of SKOS concepts.\n\nA SKOS concept can be viewed as an idea or notion; a unit of thought. However, what constitutes a unit of thought is subjective, and this definition is meant to be suggestive, rather than restrictive.\n\nThe notion of a SKOS concept is useful when describing the conceptual or intellectual structure of a knowledge organization system, and when referring to specific ideas or meanings established within a KOS.\n\nNote that, because SKOS is designed to be a vehicle for representing semi-formal KOS, such as thesauri and classification schemes, a certain amount of flexibility has been built in to the formal definition of this class.\n\nSee the SKOS primer [https://www.w3.org/TR/skos-primer/] for more examples of identifying and describing SKOS concepts."@en;
  
.

skos:Concept-altLabel
  a rdf:Property, owl:ObjectProperty, ucmis:Attribute;
  rdfs:label "altLabel";
  
  rdfs:domain skos:Concept;
  rdfs:range skos:LanguageString;
.

skos:Concept-definition
  a rdf:Property, owl:ObjectProperty, ucmis:Attribute;
  rdfs:label "definition";
  
  rdfs:domain skos:Concept;
  rdfs:range skos:LanguageString;
.

skos:Concept-identifier
  a rdf:Property, owl:DatatypeProperty, ucmis:Attribute;
  rdfs:label "identifier";
  
  rdfs:domain skos:Concept;
  rdfs:range xsd:anyURI;
.

skos:Concept-notation
  a rdf:Property, owl:DatatypeProperty, ucmis:Attribute;
  rdfs:label "notation";
  
  rdfs:domain skos:Concept;
  rdfs:range xsd:string;
.

skos:Concept-prefLabel
  a rdf:Property, owl:ObjectProperty, ucmis:Attribute;
  rdfs:label "prefLabel";
  
  rdfs:domain skos:Concept;
  rdfs:range skos:LanguageString;
.


skos:Concept_narrower_Concept
  a rdf:Property, owl:ObjectProperty, ucmis:Association;
  # ASSOCIATION
  rdfs:label "narrower_Concept";
  skos:altLabel "Concept_narrower_Concept";
  rdfs:comment "https://www.w3.org/TR/skos-reference/#narrower"@en;
  rdfs:domain skos:Concept;
  rdfs:range skos:Concept;
.

skos:Concept_inScheme_ConceptScheme
  a rdf:Property, owl:ObjectProperty, ucmis:Association;
  # ASSOCIATION
  rdfs:label "inScheme_ConceptScheme";
  skos:altLabel "Concept_inScheme_ConceptScheme";
  rdfs:comment "https://www.w3.org/TR/skos-reference/#inScheme"@en;
  rdfs:domain skos:Concept;
  rdfs:range skos:ConceptScheme;
.

skos:Concept_topConceptOf_ConceptScheme
  a rdf:Property, owl:ObjectProperty, ucmis:Association;
  # ASSOCIATION
  rdfs:label "topConceptOf_ConceptScheme";
  skos:altLabel "Concept_topConceptOf_ConceptScheme";
  rdfs:comment "https://www.w3.org/TR/skos-reference/#topConceptOf"@en;
  rdfs:domain skos:Concept;
  rdfs:range skos:ConceptScheme;
.

skos:Concept_broader_Concept
  a rdf:Property, owl:ObjectProperty, ucmis:Association;
  # ASSOCIATION
  rdfs:label "broader_Concept";
  skos:altLabel "Concept_broader_Concept";
  rdfs:comment "https://www.w3.org/TR/skos-reference/#broader"@en;
  rdfs:domain skos:Concept;
  rdfs:range skos:Concept;
.


