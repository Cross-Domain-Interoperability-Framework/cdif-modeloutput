# class ConceptScheme
# based on the UML class SKOS::Classes::ConceptScheme
skos:ConceptScheme
  a rdfs:Class, owl:Class, ucmis:Class;
  rdfs:label "ConceptScheme";
  rdfs:comment "Definition\n==========\nA SKOS concept scheme can be viewed as an aggregation of one or more SKOS concepts. Semantic relationships (links) between those concepts may also be viewed as part of a concept scheme. This definition is, however, meant to be suggestive rather than restrictive, and there is some flexibility in the formal data model stated below.\n\nThe notion of a concept scheme is useful when dealing with data from an unknown source, and when dealing with data that describes two or more different knowledge organization systems.\n\nSee the SKOS primer [https://www.w3.org/TR/skos-primer/] for more examples of identifying and describing concept schemes."@en;
  
.


skos:ConceptScheme_hasTopConcept_Concept
  a rdf:Property, owl:ObjectProperty, ucmis:Association;
  # ASSOCIATION
  rdfs:label "hasTopConcept_Concept";
  skos:altLabel "ConceptScheme_hasTopConcept_Concept";
  rdfs:comment "https://www.w3.org/TR/skos-reference/#hasTopConcept"@en;
  rdfs:domain skos:ConceptScheme;
  rdfs:range skos:Concept;
.


