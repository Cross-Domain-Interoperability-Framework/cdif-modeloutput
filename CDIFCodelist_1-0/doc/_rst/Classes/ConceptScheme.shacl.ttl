# class ConceptScheme
# based on the UML class SKOS::Classes::ConceptScheme
<#ConceptScheme> a sh:NodeShape;
    sh:targetClass skos:ConceptScheme;
	sh:message "See http://www.w3.org/2004/02/skos/core#ConceptScheme";
	sh:closed true;
	sh:ignoredProperties ( owl:sameAs );
    sh:property [
			sh:path rdf:type;
			sh:in (   skos:ConceptScheme
			 ) ;
    ];
    # attributes
    # associations from ConceptScheme
    sh:property <#ConceptScheme_hasTopConcept_Concept>;
    # associations to ConceptScheme
    sh:property <#rev_Concept_inScheme_ConceptScheme>;
    sh:property <#rev_Concept_topConceptOf_ConceptScheme>;



.


<#ConceptScheme_hasTopConcept_Concept> a sh:PropertyShape ;
    sh:path skos:ConceptScheme_hasTopConcept_Concept;
	sh:node [ sh:property [ sh:path rdf:type; sh:minCount 1; sh:in (
        skos:Concept
      
    ) ]];
    sh:minCount 1;
    sh:maxCount 1;
.
<#rev_ConceptScheme_hasTopConcept_Concept> a sh:PropertyShape ;
    sh:path [ sh:inversePath skos:ConceptScheme_hasTopConcept_Concept ];
    sh:minCount 1;
    sh:maxCount 1;
.

