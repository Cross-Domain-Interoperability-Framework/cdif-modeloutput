# datatype ObjectName
# based on the UML data type CDIF::DDSC::DataTypes::StructuredDataTypes::ObjectName
<#ObjectName> a sh:NodeShape;
    sh:targetClass ddsc:ObjectName;
	sh:message "See http://w3id.org/cdif/ddsc/1.0/ddsc/ObjectName";
	sh:closed true;
	sh:ignoredProperties ( owl:sameAs );
    sh:property [
			sh:path rdf:type;
			sh:in (   ddsc:ObjectName
			 ) ;
    ];
    # attributes
    sh:property <#ObjectName-context>;
    sh:property <#ObjectName-name>;



.

<#ObjectName-context> a sh:PropertyShape ;
    sh:path ddsc:ObjectName-context;
    sh:node [ sh:property [ sh:path rdf:type; sh:minCount 1; sh:in (
        ddsc:ControlledVocabularyEntry
      
    ) ]];
    sh:minCount 1;
    sh:maxCount 1;
.
<#ObjectName-name> a sh:PropertyShape ;
    sh:path ddsc:ObjectName-name;
    sh:datatype xsd:string;
    sh:minCount 1;
    sh:maxCount 1;
.

