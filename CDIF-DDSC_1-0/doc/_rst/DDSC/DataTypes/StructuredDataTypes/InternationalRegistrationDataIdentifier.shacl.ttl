# datatype InternationalRegistrationDataIdentifier
# based on the UML data type CDIF::DDSC::DataTypes::StructuredDataTypes::InternationalRegistrationDataIdentifier
<#InternationalRegistrationDataIdentifier> a sh:NodeShape;
    sh:targetClass ddsc:InternationalRegistrationDataIdentifier;
	sh:message "See http://w3id.org/cdif/ddsc/1.0/ddsc/InternationalRegistrationDataIdentifier";
	sh:closed true;
	sh:ignoredProperties ( owl:sameAs );
    sh:property [
			sh:path rdf:type;
			sh:in (   ddsc:InternationalRegistrationDataIdentifier
			 ) ;
    ];
    # attributes
    sh:property <#InternationalRegistrationDataIdentifier-dataIdentifier>;
    sh:property <#InternationalRegistrationDataIdentifier-registrationAuthorityIdentifier>;
    sh:property <#InternationalRegistrationDataIdentifier-versionIdentifier>;



.

<#InternationalRegistrationDataIdentifier-dataIdentifier> a sh:PropertyShape ;
    sh:path ddsc:InternationalRegistrationDataIdentifier-dataIdentifier;
    sh:datatype xsd:string;
    sh:minCount 1;
    sh:maxCount 1;
.
<#InternationalRegistrationDataIdentifier-registrationAuthorityIdentifier> a sh:PropertyShape ;
    sh:path ddsc:InternationalRegistrationDataIdentifier-registrationAuthorityIdentifier;
    sh:datatype xsd:string;
    sh:minCount 1;
    sh:maxCount 1;
.
<#InternationalRegistrationDataIdentifier-versionIdentifier> a sh:PropertyShape ;
    sh:path ddsc:InternationalRegistrationDataIdentifier-versionIdentifier;
    sh:datatype xsd:string;
    sh:minCount 1;
    sh:maxCount 1;
.

