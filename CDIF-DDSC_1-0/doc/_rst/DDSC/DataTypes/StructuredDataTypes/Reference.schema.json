      "then": { "items": { "$ref": "#/defs/dt-NonDdiIdentifier" } },
      "else": { "$ref": "#/defs/dt-NonDdiIdentifier" }
    },
    "semantic": {
      "$comment": "cardinality 1..1 – from ddsc:Reference",
