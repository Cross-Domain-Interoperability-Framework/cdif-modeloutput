# datatype TextPositionSelector
# based on the UML data type CDIF::DDSC::DataTypes::StructuredDataTypes::TextPositionSelector
<#TextPositionSelector> a sh:NodeShape;
    sh:targetClass ddsc:TextPositionSelector;
	sh:message "See http://w3id.org/cdif/ddsc/1.0/ddsc/TextPositionSelector";
	sh:closed true;
	sh:ignoredProperties ( owl:sameAs );
    sh:property [
			sh:path rdf:type;
			sh:in (   ddsc:TextPositionSelector
			 ) ;
    ];
    # attributes
    sh:property <#TextPositionSelector-end>;
    sh:property <#TextPositionSelector-start>;



.

<#TextPositionSelector-end> a sh:PropertyShape ;
    sh:path ddsc:TextPositionSelector-end;
    sh:datatype xsd:integer;
    sh:minCount 1;
    sh:maxCount 1;
.
<#TextPositionSelector-start> a sh:PropertyShape ;
    sh:path ddsc:TextPositionSelector-start;
    sh:datatype xsd:integer;
    sh:minCount 1;
    sh:maxCount 1;
.

