# datatype CombinedDate
# based on the UML data type CDIF::DDSC::DataTypes::StructuredDataTypes::CombinedDate
<#CombinedDate> a sh:NodeShape;
    sh:targetClass ddsc:CombinedDate;
	sh:message "See http://w3id.org/cdif/ddsc/1.0/ddsc/CombinedDate";
	sh:closed true;
	sh:ignoredProperties ( owl:sameAs );
    sh:property [
			sh:path rdf:type;
			sh:in (   ddsc:CombinedDate
			 ) ;
    ];
    # attributes
    sh:property <#CombinedDate-isoDate>;
    sh:property <#CombinedDate-nonIsoDate>;
    sh:property <#CombinedDate-semantics>;



.

<#CombinedDate-isoDate> a sh:PropertyShape ;
    sh:path ddsc:CombinedDate-isoDate;
    sh:datatype xsd:date;
    sh:minCount 1;
    sh:maxCount 1;
.
<#CombinedDate-nonIsoDate> a sh:PropertyShape ;
    sh:path ddsc:CombinedDate-nonIsoDate;
    sh:node [ sh:property [ sh:path rdf:type; sh:minCount 1; sh:in (
        ddsc:NonIsoDate
      
    ) ]];
    sh:minCount 1;
.
<#CombinedDate-semantics> a sh:PropertyShape ;
    sh:path ddsc:CombinedDate-semantics;
    sh:node [ sh:property [ sh:path rdf:type; sh:minCount 1; sh:in (
        ddsc:ControlledVocabularyEntry
      
    ) ]];
    sh:minCount 1;
    sh:maxCount 1;
.

