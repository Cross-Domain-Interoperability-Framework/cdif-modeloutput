# datatype XsdDate
# based on the UML data type CDIF::DDSC::DataTypes::XMLSchemaDataTypes::XsdDate
<#XsdDate> a sh:NodeShape;
    sh:targetClass xsd:date;
	sh:message "See http://w3id.org/cdif/ddsc/1.0/ddsc/XsdDate";
	sh:closed true;
	sh:ignoredProperties ( owl:sameAs );
    sh:property [
			sh:path rdf:type;
			sh:in (   xsd:date
			 ) ;
    ];
    # attributes



.


