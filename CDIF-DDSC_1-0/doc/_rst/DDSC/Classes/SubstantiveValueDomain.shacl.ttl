# class SubstantiveValueDomain
# based on the UML class CDIF::DDSC::Classes::SubstantiveValueDomain
<#SubstantiveValueDomain> a sh:NodeShape;
    sh:targetClass ddsc:SubstantiveValueDomain;
	sh:message "See http://w3id.org/cdif/ddsc/1.0/ddsc/SubstantiveValueDomain";
	sh:closed true;
	sh:ignoredProperties ( owl:sameAs );
    sh:property [
			sh:path rdf:type;
			sh:in (   ddsc:SubstantiveValueDomain
			 ) ;
    ];
    # attributes
    sh:property <#SubstantiveValueDomain-recommendedDataType>;
    # associations from SubstantiveValueDomain
    # associations to SubstantiveValueDomain
    sh:property <#rev_InstanceVariable_takesSubstantiveValuesFrom_SubstantiveValueDomain>;
    sh:property <#rev_RepresentedVariable_takesSubstantiveValuesFrom_SubstantiveValueDomain>;
    sh:property <#rev_ReferenceVariable_takesSubstantiveValuesFrom_SubstantiveValueDomain>;



.

<#SubstantiveValueDomain-recommendedDataType> a sh:PropertyShape ;
    sh:path ddsc:SubstantiveValueDomain-recommendedDataType;
    sh:node [ sh:property [ sh:path rdf:type; sh:minCount 1; sh:in (
        ddsc:ControlledVocabularyEntry
      
    ) ]];
    sh:minCount 1;
    sh:maxCount 1;
.


