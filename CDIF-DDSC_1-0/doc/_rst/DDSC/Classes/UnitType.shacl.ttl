# class UnitType
# based on the UML class CDIF::DDSC::Classes::UnitType
<#UnitType> a sh:NodeShape;
    sh:targetClass ddsc:UnitType;
	sh:message "See http://w3id.org/cdif/ddsc/1.0/ddsc/UnitType";
	sh:closed true;
	sh:ignoredProperties ( owl:sameAs );
    sh:property [
			sh:path rdf:type;
			sh:in (   ddsc:UnitType
			 ) ;
    ];
    # attributes
    sh:property <#UnitType-descriptiveText>;
    sh:property <#UnitType-name>;
    # associations from UnitType
    # associations to UnitType
    sh:property <#rev_LogicalRecord_isDefinedBy_UnitType>;
    sh:property <#rev_Universe_uses_UnitType>;



.

<#UnitType-descriptiveText> a sh:PropertyShape ;
    sh:path ddsc:UnitType-descriptiveText;
    sh:node [ sh:property [ sh:path rdf:type; sh:minCount 1; sh:in (
        ddsc:InternationalString
      
    ) ]];
    sh:minCount 1;
    sh:maxCount 1;
.
<#UnitType-name> a sh:PropertyShape ;
    sh:path ddsc:UnitType-name;
    sh:node [ sh:property [ sh:path rdf:type; sh:minCount 1; sh:in (
        ddsc:ObjectName
      
    ) ]];
    sh:minCount 1;
    sh:maxCount 1;
.


