          "$ref": "#/defs/target-IdentifierComponent"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/defs/target-IdentifierComponent"
          }
        }
      ]
    },
    "has_AttributeComponent": {
      "description": "WideDataStructure_has_AttributeComponent",
      "$comment": "cardinality 1..-1",
      "anyOf": [
        {
          "$ref": "#/defs/target-AttributeComponent"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/defs/target-AttributeComponent"
          }
        }
      ]
    },
    "has_MeasureComponent": {
      "description": "WideDataStructure_has_MeasureComponent",
      "$comment": "cardinality 1..-1",
