	sh:node [ sh:property [ sh:path rdf:type; sh:minCount 1; sh:in (
        ddsc:LongDataSet
      
    ) ]];
    sh:minCount 1;
.
<#rev_LogicalRecord_organizes_LongDataSet> a sh:PropertyShape ;
    sh:path [ sh:inversePath ddsc:LogicalRecord_organizes_LongDataSet ];
    sh:minCount 1;
.
