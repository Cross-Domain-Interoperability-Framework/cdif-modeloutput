	sh:node [ sh:property [ sh:path rdf:type; sh:minCount 1; sh:in (
        ddsc:DimensionalDataSet
      
    ) ]];
    sh:minCount 1;
.
<#rev_LogicalRecord_organizes_DimensionalDataSet> a sh:PropertyShape ;
    sh:path [ sh:inversePath ddsc:LogicalRecord_organizes_DimensionalDataSet ];
    sh:minCount 1;
.
<#LogicalRecord_has_InstanceVariable> a sh:PropertyShape ;
    sh:path ddsc:LogicalRecord_has_InstanceVariable;
	sh:node [ sh:property [ sh:path rdf:type; sh:minCount 1; sh:in (
        ddsc:InstanceVariable
      
    ) ]];
    sh:minCount 1;
.
<#rev_LogicalRecord_has_InstanceVariable> a sh:PropertyShape ;
