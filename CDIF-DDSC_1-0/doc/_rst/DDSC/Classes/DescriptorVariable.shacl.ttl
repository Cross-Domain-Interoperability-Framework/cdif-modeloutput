# class DescriptorVariable
# based on the UML class CDIF::DDSC::Classes::DescriptorVariable
<#DescriptorVariable> a sh:NodeShape;
    sh:targetClass ddsc:DescriptorVariable;
	sh:message "See http://w3id.org/cdif/ddsc/1.0/ddsc/DescriptorVariable";
	sh:closed true;
	sh:ignoredProperties ( owl:sameAs );
    sh:property [
			sh:path rdf:type;
			sh:in (   ddsc:DescriptorVariable
			 ) ;
    ];
    # attributes
    sh:property <#DescriptorVariable-name>;
    # associations from DescriptorVariable
    sh:property <#DescriptorVariable_takesSubstantiveValuesFrom_DescriptorValueDomain>;
    # associations to DescriptorVariable
    sh:property <#rev_ValueMapping_formats_DescriptorVariable>;



.

<#DescriptorVariable-name> a sh:PropertyShape ;
    sh:path ddsc:DescriptorVariable-name;
    sh:node [ sh:property [ sh:path rdf:type; sh:minCount 1; sh:in (
        ddsc:ObjectName
      
    ) ]];
    sh:minCount 1;
    sh:maxCount 1;
.

<#DescriptorVariable_takesSubstantiveValuesFrom_DescriptorValueDomain> a sh:PropertyShape ;
    sh:path ddsc:DescriptorVariable_takesSubstantiveValuesFrom_DescriptorValueDomain;
	sh:node [ sh:property [ sh:path rdf:type; sh:minCount 1; sh:in (
        ddsc:DescriptorValueDomain
      
    ) ]];
    sh:minCount 1;
.
<#rev_DescriptorVariable_takesSubstantiveValuesFrom_DescriptorValueDomain> a sh:PropertyShape ;
    sh:path [ sh:inversePath ddsc:DescriptorVariable_takesSubstantiveValuesFrom_DescriptorValueDomain ];
    sh:minCount 1;
    sh:maxCount 1;
.

