# class DimensionalDataStructure
# based on the UML class CDIF::DDSC::Classes::DimensionalDataStructure
<#DimensionalDataStructure> a sh:NodeShape;
    sh:targetClass ddsc:DimensionalDataStructure;
	sh:message "See http://w3id.org/cdif/ddsc/1.0/ddsc/DimensionalDataStructure";
	sh:closed true;
	sh:ignoredProperties ( owl:sameAs );
    sh:property [
			sh:path rdf:type;
			sh:in (   ddsc:DimensionalDataStructure
			 ) ;
    ];
    # attributes
    # associations from DimensionalDataStructure
    sh:property <#DimensionalDataStructure_has_IdentifierComponent>;
    sh:property <#DimensionalDataStructure_has_AttributeComponent>;
    sh:property <#DimensionalDataStructure_has_MeasureComponent>;
    sh:property <#DimensionalDataStructure_has_ComponentPosition>;
    # associations to DimensionalDataStructure



.


<#DimensionalDataStructure_has_IdentifierComponent> a sh:PropertyShape ;
    sh:path ddsc:DimensionalDataStructure_has_IdentifierComponent;
	sh:node [ sh:property [ sh:path rdf:type; sh:minCount 1; sh:in (
        ddsc:IdentifierComponent
      
    ) ]];
    sh:minCount 1;
.
<#rev_DimensionalDataStructure_has_IdentifierComponent> a sh:PropertyShape ;
    sh:path [ sh:inversePath ddsc:DimensionalDataStructure_has_IdentifierComponent ];
    sh:minCount 1;
    sh:maxCount 1;
.
<#DimensionalDataStructure_has_AttributeComponent> a sh:PropertyShape ;
    sh:path ddsc:DimensionalDataStructure_has_AttributeComponent;
	sh:node [ sh:property [ sh:path rdf:type; sh:minCount 1; sh:in (
        ddsc:AttributeComponent
      
    ) ]];
    sh:minCount 1;
.
<#rev_DimensionalDataStructure_has_AttributeComponent> a sh:PropertyShape ;
    sh:path [ sh:inversePath ddsc:DimensionalDataStructure_has_AttributeComponent ];
    sh:minCount 1;
    sh:maxCount 1;
.
<#DimensionalDataStructure_has_MeasureComponent> a sh:PropertyShape ;
    sh:path ddsc:DimensionalDataStructure_has_MeasureComponent;
	sh:node [ sh:property [ sh:path rdf:type; sh:minCount 1; sh:in (
        ddsc:MeasureComponent
      
    ) ]];
    sh:minCount 1;
.
<#rev_DimensionalDataStructure_has_MeasureComponent> a sh:PropertyShape ;
    sh:path [ sh:inversePath ddsc:DimensionalDataStructure_has_MeasureComponent ];
    sh:minCount 1;
    sh:maxCount 1;
.
<#DimensionalDataStructure_has_ComponentPosition> a sh:PropertyShape ;
    sh:path ddsc:DimensionalDataStructure_has_ComponentPosition;
	sh:node [ sh:property [ sh:path rdf:type; sh:minCount 1; sh:in (
        ddsc:ComponentPosition
      
    ) ]];
    sh:minCount 1;
.
<#rev_DimensionalDataStructure_has_ComponentPosition> a sh:PropertyShape ;
    sh:path [ sh:inversePath ddsc:DimensionalDataStructure_has_ComponentPosition ];
    sh:minCount 1;
    sh:maxCount 1;
.

