.
<#rev_LongDataStructure_has_AttributeComponent> a sh:PropertyShape ;
    sh:path [ sh:inversePath ddsc:LongDataStructure_has_AttributeComponent ];
    sh:minCount 1;
    sh:maxCount 1;
.
<#LongDataStructure_has_VariableDescriptorComponent> a sh:PropertyShape ;
    sh:path ddsc:LongDataStructure_has_VariableDescriptorComponent;
	sh:node [ sh:property [ sh:path rdf:type; sh:minCount 1; sh:in (
        ddsc:VariableDescriptorComponent
      
    ) ]];
    sh:minCount 1;
.
<#rev_LongDataStructure_has_VariableDescriptorComponent> a sh:PropertyShape ;
    sh:path [ sh:inversePath ddsc:LongDataStructure_has_VariableDescriptorComponent ];
