.
<#LongDataStructure_has_VariableValueComponent> a sh:PropertyShape ;
    sh:path ddsc:LongDataStructure_has_VariableValueComponent;
	sh:node [ sh:property [ sh:path rdf:type; sh:minCount 1; sh:in (
