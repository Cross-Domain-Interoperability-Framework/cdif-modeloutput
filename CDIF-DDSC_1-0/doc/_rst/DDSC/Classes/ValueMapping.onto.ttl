.

ddsc:ValueMapping_formats_DescriptorVariable
  a rdf:Property, owl:ObjectProperty, ucmis:Association;
  # ASSOCIATION
  rdfs:label "formats_DescriptorVariable";
  skos:altLabel "ValueMapping_formats_DescriptorVariable";
  
  rdfs:domain ddsc:ValueMapping;
  rdfs:range ddsc:DescriptorVariable;
.


