.
<#PhysicalSegmentLayout-headerRowCount> a sh:PropertyShape ;
    sh:path ddsc:PhysicalSegmentLayout-headerRowCount;
    sh:datatype xsd:integer;
    sh:minCount 1;
    sh:maxCount 1;
.
<#PhysicalSegmentLayout-isDelimited> a sh:PropertyShape ;
    sh:path ddsc:PhysicalSegmentLayout-isDelimited;
