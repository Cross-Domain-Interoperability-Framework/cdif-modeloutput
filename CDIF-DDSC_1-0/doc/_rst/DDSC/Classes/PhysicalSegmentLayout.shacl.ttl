    sh:datatype xsd:string;
    sh:minCount 1;
    sh:maxCount 1;
.
<#PhysicalSegmentLayout-skipInitialSpace> a sh:PropertyShape ;
    sh:path ddsc:PhysicalSegmentLayout-skipInitialSpace;
    sh:datatype xsd:boolean;
    sh:minCount 1;
    sh:maxCount 1;
.
<#PhysicalSegmentLayout-trim> a sh:PropertyShape ;
    sh:path ddsc:PhysicalSegmentLayout-trim;
    sh:node [ sh:property [ sh:path rdf:type; sh:minCount 1; sh:in (
        ddsc:TrimValues
      
    ) ]];
    sh:minCount 1;
    sh:maxCount 1;
.

<#PhysicalSegmentLayout_formats_LogicalRecord> a sh:PropertyShape ;
    sh:path ddsc:PhysicalSegmentLayout_formats_LogicalRecord;
	sh:node [ sh:property [ sh:path rdf:type; sh:minCount 1; sh:in (
