.
<#PhysicalSegmentLayout_has_ValueMapping> a sh:PropertyShape ;
    sh:path ddsc:PhysicalSegmentLayout_has_ValueMapping;
	sh:node [ sh:property [ sh:path rdf:type; sh:minCount 1; sh:in (
