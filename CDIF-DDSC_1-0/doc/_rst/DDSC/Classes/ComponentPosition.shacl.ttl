# class ComponentPosition
# based on the UML class CDIF::DDSC::Classes::ComponentPosition
<#ComponentPosition> a sh:NodeShape;
    sh:targetClass ddsc:ComponentPosition;
	sh:message "See http://w3id.org/cdif/ddsc/1.0/ddsc/ComponentPosition";
	sh:closed true;
	sh:ignoredProperties ( owl:sameAs );
    sh:property [
			sh:path rdf:type;
			sh:in (   ddsc:ComponentPosition
			 ) ;
    ];
    # attributes
    sh:property <#ComponentPosition-value>;
    # associations from ComponentPosition
    sh:property <#ComponentPosition_indexes_DimensionComponent>;
    # associations to ComponentPosition
    sh:property <#rev_DimensionalDataStructure_has_ComponentPosition>;



.

<#ComponentPosition-value> a sh:PropertyShape ;
    sh:path ddsc:ComponentPosition-value;
    sh:datatype xsd:integer;
    sh:minCount 1;
    sh:maxCount 1;
.

<#ComponentPosition_indexes_DimensionComponent> a sh:PropertyShape ;
    sh:path ddsc:ComponentPosition_indexes_DimensionComponent;
	sh:node [ sh:property [ sh:path rdf:type; sh:minCount 1; sh:in (
        ddsc:DimensionComponent
      
    ) ]];
    sh:minCount 1;
    sh:maxCount 1;
.
<#rev_ComponentPosition_indexes_DimensionComponent> a sh:PropertyShape ;
    sh:path [ sh:inversePath ddsc:ComponentPosition_indexes_DimensionComponent ];
    sh:minCount 1;
.

