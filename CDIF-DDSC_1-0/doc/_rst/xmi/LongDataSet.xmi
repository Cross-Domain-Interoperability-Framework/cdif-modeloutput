<?xml version="1.0" encoding="UTF-8"?>
<packagedElement xmlns:uml="http://www.omg.org/spec/UML/20131001"
                  xmlns:xmi="http://www.omg.org/spec/XMI/20131001"
                  xmi:id="ddsc.LongDataSet"
                  xmi:uuid="http://w3id.org/cdif/ddsc/1.0/ddsc/xmi/#LongDataSet"
                  xmi:type="uml:Class">
   <ownedComment xmi:id="ddsc.LongDataSet-ownedComment"
                  xmi:uuid="http://w3id.org/cdif/ddsc/1.0/ddsc/xmi/#LongDataSet-ownedComment"
                  xmi:type="uml:Comment">
      <body>Definition
============
Organized collection of long data. It is structured by a long data structure.

Examples
==========
A unit dataset where each row corresponds to a set of data points capturing different characteristics of a unit, some of which can be transposed into variable descriptor and variable value components.</body>
      <annotatedElement xmi:idref="ddsc.LongDataSet"/>
   </ownedComment>
   <name>LongDataSet</name>
   <ownedAttribute xmi:id="ddsc.LongDataSet-name"
                    xmi:uuid="http://w3id.org/cdif/ddsc/1.0/ddsc/xmi/#LongDataSet-name"
                    xmi:type="uml:Property">
      <ownedComment xmi:id="ddsc.LongDataSet-name-ownedComment"
                     xmi:uuid="http://w3id.org/cdif/ddsc/1.0/ddsc/xmi/#LongDataSet-name-ownedComment"
                     xmi:type="uml:Comment">
         <body>Human understandable name (liguistic signifier, word, phrase, or mnemonic). May follow ISO/IEC 11179-5 naming principles, and have context provided to specify usage.</body>
         <annotatedElement xmi:idref="ddsc.LongDataSet-name"/>
      </ownedComment>
      <name>name</name>
      <type xmi:idref="ddsc.ObjectName"/>
   </ownedAttribute>
   <ownedAttribute xmi:id="ddsc.LongDataSet-physicalFileName"
                    xmi:uuid="http://w3id.org/cdif/ddsc/1.0/ddsc/xmi/#LongDataSet-physicalFileName"
                    xmi:type="uml:Property">
      <ownedComment xmi:id="ddsc.LongDataSet-physicalFileName-ownedComment"
                     xmi:uuid="http://w3id.org/cdif/ddsc/1.0/ddsc/xmi/#LongDataSet-physicalFileName-ownedComment"
                     xmi:type="uml:Comment">
         <body>Use when multiple physical segments are stored in a single file.</body>
         <annotatedElement xmi:idref="ddsc.LongDataSet-physicalFileName"/>
      </ownedComment>
      <name>physicalFileName</name>
      <type xmi:type="uml:PrimitiveType"
             href="http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#String"/>
   </ownedAttribute>
</packagedElement>
