<?xml version="1.0" encoding="UTF-8"?>
<packagedElement xmlns:uml="http://www.omg.org/spec/UML/20131001"
                  xmlns:xmi="http://www.omg.org/spec/XMI/20131001"
                  xmi:id="ddsc.WideDataStructure"
                  xmi:uuid="http://w3id.org/cdif/ddsc/1.0/ddsc/xmi/#WideDataStructure"
                  xmi:type="uml:Class">
   <ownedComment xmi:id="ddsc.WideDataStructure-ownedComment"
                  xmi:uuid="http://w3id.org/cdif/ddsc/1.0/ddsc/xmi/#WideDataStructure-ownedComment"
                  xmi:type="uml:Comment">
      <body>Definition
==========
Structure of a wide dataset (organized collection of wide data). It is described by identifier, measure and attribute components.

Examples
==========
The structure described by [Unit id, Income, Province] where Unit id identifies a statistical unit and Income and Province are two instance variables capturing characteristics.</body>
      <annotatedElement xmi:idref="ddsc.WideDataStructure"/>
   </ownedComment>
   <name>WideDataStructure</name>
   <ownedAttribute xmi:id="ddsc.WideDataStructure-ownedAttribute-1"
                    xmi:uuid="http://w3id.org/cdif/ddsc/1.0/ddsc/xmi/#WideDataStructure-ownedAttribute-1"
                    xmi:type="uml:Property">
      <type xmi:idref="ddsc.PrimaryKey"/>
      <association xmi:idref="ddsc.WideDataStructure_has_PrimaryKey"/>
   </ownedAttribute>
   <ownedAttribute xmi:id="ddsc.WideDataStructure-ownedAttribute-2"
                    xmi:uuid="http://w3id.org/cdif/ddsc/1.0/ddsc/xmi/#WideDataStructure-ownedAttribute-2"
                    xmi:type="uml:Property">
      <type xmi:idref="ddsc.IdentifierComponent"/>
      <upperValue xmi:id="ddsc.WideDataStructure-ownedAttribute-2-upperValue"
                   xmi:uuid="http://w3id.org/cdif/ddsc/1.0/ddsc/xmi/#WideDataStructure-ownedAttribute-2-upperValue"
                   xmi:type="uml:LiteralUnlimitedNatural">
         <value>*</value>
      </upperValue>
      <association xmi:idref="ddsc.WideDataStructure_has_IdentifierComponent"/>
   </ownedAttribute>
   <ownedAttribute xmi:id="ddsc.WideDataStructure-ownedAttribute-3"
                    xmi:uuid="http://w3id.org/cdif/ddsc/1.0/ddsc/xmi/#WideDataStructure-ownedAttribute-3"
                    xmi:type="uml:Property">
      <type xmi:idref="ddsc.AttributeComponent"/>
      <upperValue xmi:id="ddsc.WideDataStructure-ownedAttribute-3-upperValue"
                   xmi:uuid="http://w3id.org/cdif/ddsc/1.0/ddsc/xmi/#WideDataStructure-ownedAttribute-3-upperValue"
                   xmi:type="uml:LiteralUnlimitedNatural">
         <value>*</value>
      </upperValue>
      <association xmi:idref="ddsc.WideDataStructure_has_AttributeComponent"/>
   </ownedAttribute>
   <ownedAttribute xmi:id="ddsc.WideDataStructure-ownedAttribute-4"
                    xmi:uuid="http://w3id.org/cdif/ddsc/1.0/ddsc/xmi/#WideDataStructure-ownedAttribute-4"
                    xmi:type="uml:Property">
      <type xmi:idref="ddsc.MeasureComponent"/>
      <upperValue xmi:id="ddsc.WideDataStructure-ownedAttribute-4-upperValue"
                   xmi:uuid="http://w3id.org/cdif/ddsc/1.0/ddsc/xmi/#WideDataStructure-ownedAttribute-4-upperValue"
                   xmi:type="uml:LiteralUnlimitedNatural">
         <value>*</value>
      </upperValue>
      <association xmi:idref="ddsc.WideDataStructure_has_MeasureComponent"/>
   </ownedAttribute>
</packagedElement>
