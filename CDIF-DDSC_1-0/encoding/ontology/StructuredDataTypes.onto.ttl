  a rdfs:Class, owl:Class, ucmis:StructuredDataType;
  rdfs:label "LanguageString";
  rdfs:comment "Definition\n============\nA data type which describes a string specific to a language/scope combination. It contains the following attributes: language to designate the language, isTranslated with a default value of false to designate if an object is a translation of another language, isTranslatable with a default value of true to designate if the content can be translated, translationSourceLanguage to indicate the source languages used in creating this translation, translationDate, and scope which can be used to define intended audience or use such as internal, external, etc."@en;
  
