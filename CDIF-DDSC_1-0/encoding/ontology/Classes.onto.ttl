  a rdf:Property, owl:ObjectProperty, ucmis:Association;
  # ASSOCIATION
  rdfs:label "formats_InstanceVariable";
  skos:altLabel "ValueMapping_formats_InstanceVariable";
  
  rdfs:domain ddsc:ValueMapping;
