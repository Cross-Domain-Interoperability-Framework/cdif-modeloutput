  rdfs:range ddsc:ValueMapping;
.


# class WideDataSet
# based on the UML class CDIF::DDSC::Classes::WideDataSet
ddsc:WideDataSet
  a rdfs:Class, owl:Class, ucmis:Class;
  rdfs:label "WideDataSet";
  rdfs:comment "Definition\n============\nOrganized collection of wide data. It is structured by a wide data structure.\n\nExamples\n==========\nA unit dataset where each row corresponds to a set of data points capturing different characteristics of a unit."@en;
  
.

ddsc:WideDataSet-name
  a rdf:Property, owl:ObjectProperty, ucmis:Attribute;
  rdfs:label "name";
  rdfs:comment "Human understandable name (liguistic signifier, word, phrase, or mnemonic). May follow ISO/IEC 11179-5 naming principles, and have context provided to specify usage."@en;
  rdfs:domain ddsc:WideDataSet;
  rdfs:range ddsc:ObjectName;
.

ddsc:WideDataSet-physicalFileName
  a rdf:Property, owl:DatatypeProperty, ucmis:Attribute;
  rdfs:label "physicalFileName";
  rdfs:comment "Use when multiple physical segments are stored in a single file."@en;
  rdfs:domain ddsc:WideDataSet;
  rdfs:range xsd:string;
.



# class LongDataSet
# based on the UML class CDIF::DDSC::Classes::LongDataSet
ddsc:LongDataSet
  a rdfs:Class, owl:Class, ucmis:Class;
  rdfs:label "LongDataSet";
  rdfs:comment "Definition\n============\nOrganized collection of long data. It is structured by a long data structure.\n\nExamples\n==========\nA unit dataset where each row corresponds to a set of data points capturing different characteristics of a unit, some of which can be transposed into variable descriptor and variable value components."@en;
  
.

ddsc:LongDataSet-name
  a rdf:Property, owl:ObjectProperty, ucmis:Attribute;
  rdfs:label "name";
  rdfs:comment "Human understandable name (liguistic signifier, word, phrase, or mnemonic). May follow ISO/IEC 11179-5 naming principles, and have context provided to specify usage."@en;
  rdfs:domain ddsc:LongDataSet;
  rdfs:range ddsc:ObjectName;
.

ddsc:LongDataSet-physicalFileName
  a rdf:Property, owl:DatatypeProperty, ucmis:Attribute;
  rdfs:label "physicalFileName";
  rdfs:comment "Use when multiple physical segments are stored in a single file."@en;
  rdfs:domain ddsc:LongDataSet;
  rdfs:range xsd:string;
.



# class DimensionalDataSet
# based on the UML class CDIF::DDSC::Classes::DimensionalDataSet
ddsc:DimensionalDataSet
  a rdfs:Class, owl:Class, ucmis:Class;
  rdfs:label "DimensionalDataSet";
  rdfs:comment "Definition\n============\nOrganized collection of multidimensional data. It is structured by a dimensional data structure.\n\nExamples\n==========\nA dimensional dataset with Income values in each data point, where the dimensions organizing the data points are Sex and Marital Status.\n\nExplanatory notes\n===================\nSimilar to Structural N-Cube."@en;
  
.

ddsc:DimensionalDataSet-name
  a rdf:Property, owl:ObjectProperty, ucmis:Attribute;
  rdfs:label "name";
  rdfs:comment "Human understandable name (liguistic signifier, word, phrase, or mnemonic). May follow ISO/IEC 11179-5 naming principles, and have context provided to specify usage."@en;
  rdfs:domain ddsc:DimensionalDataSet;
  rdfs:range ddsc:ObjectName;
.

ddsc:DimensionalDataSet-physicalFileName
  a rdf:Property, owl:DatatypeProperty, ucmis:Attribute;
  rdfs:label "physicalFileName";
  rdfs:comment "Use when multiple physical segments are stored in a single file."@en;
  rdfs:domain ddsc:DimensionalDataSet;
  rdfs:range xsd:string;
.





