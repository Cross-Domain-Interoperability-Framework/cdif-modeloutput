PREFIX sh: <http://www.w3.org/ns/shacl#>

# class AttributeComponent
# based on the UML class CDIF::DDSC::Classes::AttributeComponent
<#AttributeComponent> a sh:NodeShape;
    sh:targetClass ddsc:AttributeComponent;
	sh:message "See http://w3id.org/cdif/ddsc/1.0/ddsc/AttributeComponent";
	sh:closed true;
	sh:ignoredProperties ( owl:sameAs );
    sh:property [
			sh:path rdf:type;
			sh:in (   ddsc:AttributeComponent
			 ) ;
    ];
    # attributes
    # associations from AttributeComponent
    sh:property <#AttributeComponent_isDefinedBy_InstanceVariable>;
    # associations to AttributeComponent
    sh:property <#rev_WideDataStructure_has_AttributeComponent>;
    sh:property <#rev_LongDataStructure_has_AttributeComponent>;
    sh:property <#rev_DimensionalDataStructure_has_AttributeComponent>;



.


<#AttributeComponent_isDefinedBy_InstanceVariable> a sh:PropertyShape ;
    sh:path ddsc:AttributeComponent_isDefinedBy_InstanceVariable;
	sh:node [ sh:property [ sh:path rdf:type; sh:minCount 1; sh:in (
        ddsc:InstanceVariable
      
    ) ]];
    sh:minCount 1;
    sh:maxCount 1;
.
<#rev_AttributeComponent_isDefinedBy_InstanceVariable> a sh:PropertyShape ;
    sh:path [ sh:inversePath ddsc:AttributeComponent_isDefinedBy_InstanceVariable ];
    sh:minCount 1;
    sh:maxCount 1;
.

