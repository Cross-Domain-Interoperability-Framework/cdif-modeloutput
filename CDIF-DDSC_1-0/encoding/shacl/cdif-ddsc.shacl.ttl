.

<#ComponentPosition-value> a sh:PropertyShape ;
    sh:path ddsc:ComponentPosition-value;
    sh:datatype xsd:integer;
    sh:minCount 1;
    sh:maxCount 1;
.

<#ComponentPosition_indexes_DimensionComponent> a sh:PropertyShape ;
    sh:path ddsc:ComponentPosition_indexes_DimensionComponent;
	sh:node [ sh:property [ sh:path rdf:type; sh:minCount 1; sh:in (
