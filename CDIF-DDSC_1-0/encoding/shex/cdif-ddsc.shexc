	ddsc:VariableValueComponent_isDefinedBy_ReferenceVariable	@ddsc:ReferenceVariableShape ;
	
	^ddsc:VariableDescriptorComponent_refersTo_VariableValueComponent @ddsc:VariableDescriptorComponentShape ;
	}

