	ddsc:ControlledVocabularyEntry-entryValue	xsd:string+;
	ddsc:ControlledVocabularyEntry-name	xsd:string;
	ddsc:ControlledVocabularyEntry-valueForOther	xsd:string;
	ddsc:ControlledVocabularyEntry-vocabulary	@ddsc:ReferenceShape;
	}

