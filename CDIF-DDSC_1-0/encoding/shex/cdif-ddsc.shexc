# based on the UML class CDIF::DDSC::Classes::LongDataStructure
ddsc:LongDataStructureShape CLOSED {
	a [ddsc:LongDataStructure];
	ddsc:LongDataStructure_has_IdentifierComponent	@ddsc:IdentifierComponentShape +;
	
	ddsc:LongDataStructure_has_AttributeComponent	@ddsc:AttributeComponentShape +;
	
	ddsc:LongDataStructure_has_VariableDescriptorComponent	@ddsc:VariableDescriptorComponentShape +;
	
	ddsc:LongDataStructure_has_VariableValueComponent	@ddsc:VariableValueComponentShape +;
	
	}

# class MeasureComponent
# based on the UML class CDIF::DDSC::Classes::MeasureComponent
ddsc:MeasureComponentShape CLOSED {
	a [ddsc:MeasureComponent];
	^ddsc:WideDataStructure_has_MeasureComponent @ddsc:WideDataStructureShape ;
	^ddsc:DimensionalDataStructure_has_MeasureComponent @ddsc:DimensionalDataStructureShape ;
	ddsc:MeasureComponent_isDefinedBy_InstanceVariable	@ddsc:InstanceVariableShape ;
	
	}

# class PhysicalSegmentLayout
# based on the UML class CDIF::DDSC::Classes::PhysicalSegmentLayout
ddsc:PhysicalSegmentLayoutShape CLOSED {
	a [ddsc:PhysicalSegmentLayout];
	ddsc:PhysicalSegmentLayout-delimiter	xsd:string;
	ddsc:PhysicalSegmentLayout-encoding	@ddsc:ControlledVocabularyEntryShape;
	ddsc:PhysicalSegmentLayout-escapeCharacter	xsd:string;
	ddsc:PhysicalSegmentLayout-hasHeader	xsd:boolean;
	ddsc:PhysicalSegmentLayout-headerRowCount	xsd:integer;
	ddsc:PhysicalSegmentLayout-isDelimited	xsd:boolean;
	ddsc:PhysicalSegmentLayout-isFixedWidth	xsd:boolean;
	ddsc:PhysicalSegmentLayout-lineTerminator	xsd:string+;
	ddsc:PhysicalSegmentLayout-quoteCharacter	xsd:string;
	ddsc:PhysicalSegmentLayout-skipInitialSpace	xsd:boolean;
	ddsc:PhysicalSegmentLayout-trim	@ddsc:TrimValuesShape;
	ddsc:PhysicalSegmentLayout_formats_LogicalRecord	@ddsc:LogicalRecordShape ;
	
	ddsc:PhysicalSegmentLayout_has_ValueMapping	@ddsc:ValueMappingShape +;
	
	ddsc:PhysicalSegmentLayout_has_ValueMappingPosition	@ddsc:ValueMappingPositionShape +;
	
	}

# class Population
# based on the UML class CDIF::DDSC::Classes::Population
ddsc:PopulationShape CLOSED {
	a [ddsc:Population];
	ddsc:Population-descriptiveText	@ddsc:InternationalStringShape;
	ddsc:Population-name	@ddsc:ObjectNameShape;
	^ddsc:LogicalRecord_isDefinedBy_Population @ddsc:LogicalRecordShape +;
	^ddsc:InstanceVariable_measures_Population @ddsc:InstanceVariableShape ;
	ddsc:Population_uses_Universe	@ddsc:UniverseShape ;
	
	}

# class PrimaryKey
# based on the UML class CDIF::DDSC::Classes::PrimaryKey
ddsc:PrimaryKeyShape CLOSED {
	a [ddsc:PrimaryKey];
	^ddsc:WideDataStructure_has_PrimaryKey @ddsc:WideDataStructureShape ;
	ddsc:PrimaryKey_isComposedOf_PrimaryKeyComponent	@ddsc:PrimaryKeyComponentShape +;
	
	}

# class PrimaryKeyComponent
# based on the UML class CDIF::DDSC::Classes::PrimaryKeyComponent
ddsc:PrimaryKeyComponentShape CLOSED {
	a [ddsc:PrimaryKeyComponent];
	^ddsc:PrimaryKey_isComposedOf_PrimaryKeyComponent @ddsc:PrimaryKeyShape ;
	ddsc:PrimaryKeyComponent_correspondsTo_IdentifierComponent	@ddsc:IdentifierComponentShape ;
	
	}

# class ReferenceVariable
# based on the UML class CDIF::DDSC::Classes::ReferenceVariable
ddsc:ReferenceVariableShape CLOSED {
	a [ddsc:ReferenceVariable];
	ddsc:ReferenceVariable-name	@ddsc:ObjectNameShape;
	ddsc:ReferenceVariable_takesSubstantiveValuesFrom_SubstantiveValueDomain	@ddsc:SubstantiveValueDomainShape ;
	
	ddsc:ReferenceVariable_takesSentinelValuesFrom_SentinelValueDomain	@ddsc:SentinelValueDomainShape +;
	
	^ddsc:VariableValueComponent_isDefinedBy_ReferenceVariable @ddsc:VariableValueComponentShape ;
	^ddsc:ValueMapping_formats_ReferenceVariable @ddsc:ValueMappingShape ;
	}

# class RepresentedVariable
# based on the UML class CDIF::DDSC::Classes::RepresentedVariable
ddsc:RepresentedVariableShape CLOSED {
	a [ddsc:RepresentedVariable];
	ddsc:RepresentedVariable-definition	@ddsc:InternationalStringShape;
	ddsc:RepresentedVariable-describedUnitOfMeasure	@ddsc:ControlledVocabularyEntryShape;
	ddsc:RepresentedVariable-name	@ddsc:ObjectNameShape;
	ddsc:RepresentedVariable-unitOfMeasureKind	@ddsc:ControlledVocabularyEntryShape;
	ddsc:RepresentedVariable_measures_Universe	@ddsc:UniverseShape +;
	
	ddsc:RepresentedVariable_takesSubstantiveValuesFrom_SubstantiveValueDomain	@ddsc:SubstantiveValueDomainShape ;
	
	ddsc:RepresentedVariable_takesSentinelValuesFrom_SentinelValueDomain	@ddsc:SentinelValueDomainShape +;
	
	^ddsc:ValueMapping_formats_RepresentedVariable @ddsc:ValueMappingShape ;
	}

