	ddsc:CombinedDate-isoDate	xsd:date;
	ddsc:CombinedDate-nonIsoDate	@ddsc:NonIsoDateShape+;
	ddsc:CombinedDate-semantics	@ddsc:ControlledVocabularyEntryShape;
	}

