# based on the UML class CDIF::DDSC::Classes::UnitType
ddsc:UnitTypeShape CLOSED {
	a [ddsc:UnitType];
	ddsc:UnitType-descriptiveText	@ddsc:InternationalStringShape;
	ddsc:UnitType-name	@ddsc:ObjectNameShape;
	^ddsc:LogicalRecord_isDefinedBy_UnitType @ddsc:LogicalRecordShape +;
	^ddsc:Universe_uses_UnitType @ddsc:UniverseShape ;
	}

# class Universe
# based on the UML class CDIF::DDSC::Classes::Universe
ddsc:UniverseShape CLOSED {
	a [ddsc:Universe];
	ddsc:Universe-descriptiveText	@ddsc:InternationalStringShape;
	ddsc:Universe-name	@ddsc:ObjectNameShape;
	^ddsc:LogicalRecord_isDefinedBy_Universe @ddsc:LogicalRecordShape +;
	^ddsc:RepresentedVariable_measures_Universe @ddsc:RepresentedVariableShape ;
	ddsc:Universe_uses_UnitType	@ddsc:UnitTypeShape +;
	
	^ddsc:Population_uses_Universe @ddsc:PopulationShape ;
	}

# class ValueMapping
# based on the UML class CDIF::DDSC::Classes::ValueMapping
ddsc:ValueMappingShape CLOSED {
	a [ddsc:ValueMapping];
	ddsc:ValueMapping-decimalPositions	xsd:integer;
	ddsc:ValueMapping-defaultDecimalSeparator	xsd:string;
	ddsc:ValueMapping-length	xsd:integer;
	ddsc:ValueMapping-maximumLength	xsd:integer;
	ddsc:ValueMapping-minimumLength	xsd:integer;
	^ddsc:PhysicalSegmentLayout_has_ValueMapping @ddsc:PhysicalSegmentLayoutShape +;
	ddsc:ValueMapping_formats_InstanceVariable	@ddsc:InstanceVariableShape +;
	
	ddsc:ValueMapping_formats_RepresentedVariable	@ddsc:RepresentedVariableShape +;
	
	ddsc:ValueMapping_formats_ReferenceVariable	@ddsc:ReferenceVariableShape +;
	
	ddsc:ValueMapping_formats_DescriptorVariable	@ddsc:DescriptorVariableShape +;
	
	^ddsc:ValueMappingPosition_indexes_ValueMapping @ddsc:ValueMappingPositionShape +;
	}

# class ValueMappingPosition
# based on the UML class CDIF::DDSC::Classes::ValueMappingPosition
ddsc:ValueMappingPositionShape CLOSED {
	a [ddsc:ValueMappingPosition];
	ddsc:ValueMappingPosition-value	xsd:integer;
	^ddsc:PhysicalSegmentLayout_has_ValueMappingPosition @ddsc:PhysicalSegmentLayoutShape ;
	ddsc:ValueMappingPosition_indexes_ValueMapping	@ddsc:ValueMappingShape +;
	
	}

# class VariableDescriptorComponent
# based on the UML class CDIF::DDSC::Classes::VariableDescriptorComponent
ddsc:VariableDescriptorComponentShape CLOSED {
	a [ddsc:VariableDescriptorComponent];
	^ddsc:LongDataStructure_has_VariableDescriptorComponent @ddsc:LongDataStructureShape ;
	ddsc:VariableDescriptorComponent_refersTo_VariableValueComponent	@ddsc:VariableValueComponentShape ;
	
	}

