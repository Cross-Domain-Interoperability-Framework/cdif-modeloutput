PREFIX rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:   <http://www.w3.org/2002/07/owl#>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>
PREFIX dc:    <http://purl.org/dc/elements/1.1/>
PREFIX skos:  <http://www.w3.org/2004/02/skos/core#>
PREFIX ddsc:   <http://w3id.org/cdif/ddsc/1.0/ddsc/>
PREFIX ucmis: <http://ddialliance.org/Specification/UCMIS/1.0/RDF>

start = @http://w3id.org/cdif/ddsc/1.0/ddsc/:WideDataSetShape

# class AttributeComponent
# based on the UML class CDIF::DDSC::Classes::AttributeComponent
ddsc:AttributeComponentShape CLOSED {
	a [ddsc:AttributeComponent];
	^ddsc:WideDataStructure_has_AttributeComponent @ddsc:WideDataStructureShape ;
	^ddsc:LongDataStructure_has_AttributeComponent @ddsc:LongDataStructureShape ;
	^ddsc:DimensionalDataStructure_has_AttributeComponent @ddsc:DimensionalDataStructureShape ;
	ddsc:AttributeComponent_isDefinedBy_InstanceVariable	@ddsc:InstanceVariableShape ;
	
	}

# class ComponentPosition
# based on the UML class CDIF::DDSC::Classes::ComponentPosition
ddsc:ComponentPositionShape CLOSED {
	a [ddsc:ComponentPosition];
	ddsc:ComponentPosition-value	xsd:integer;
	^ddsc:DimensionalDataStructure_has_ComponentPosition @ddsc:DimensionalDataStructureShape ;
	ddsc:ComponentPosition_indexes_DimensionComponent	@ddsc:DimensionComponentShape ;
	
	}

# class DataStore
# based on the UML class CDIF::DDSC::Classes::DataStore
ddsc:DataStoreShape CLOSED {
	a [ddsc:DataStore];
	ddsc:DataStore-name	@ddsc:ObjectNameShape;
	ddsc:DataStore_has_LogicalRecord	@ddsc:LogicalRecordShape +;
	
	}

# class Descriptor
# based on the UML class CDIF::DDSC::Classes::Descriptor
ddsc:DescriptorShape CLOSED {
	a [ddsc:Descriptor];
	ddsc:Descriptor-content	@ddsc:TypedStringShape;
	ddsc:Descriptor_identifies_InstanceVariable	@ddsc:InstanceVariableShape +;
	
	}

# class DescriptorValueDomain
# based on the UML class CDIF::DDSC::Classes::DescriptorValueDomain
ddsc:DescriptorValueDomainShape CLOSED {
	a [ddsc:DescriptorValueDomain];
	^ddsc:DescriptorVariable_takesSubstantiveValuesFrom_DescriptorValueDomain @ddsc:DescriptorVariableShape ;
	}

# class DescriptorVariable
# based on the UML class CDIF::DDSC::Classes::DescriptorVariable
ddsc:DescriptorVariableShape CLOSED {
	a [ddsc:DescriptorVariable];
	ddsc:DescriptorVariable-name	@ddsc:ObjectNameShape;
	ddsc:DescriptorVariable_takesSubstantiveValuesFrom_DescriptorValueDomain	@ddsc:DescriptorValueDomainShape +;
	
	^ddsc:ValueMapping_formats_DescriptorVariable @ddsc:ValueMappingShape ;
	}

# class DimensionComponent
# based on the UML class CDIF::DDSC::Classes::DimensionComponent
ddsc:DimensionComponentShape CLOSED {
	a [ddsc:DimensionComponent];
	ddsc:DimensionComponent_isDefinedBy_InstanceVariable	@ddsc:InstanceVariableShape ;
	
	^ddsc:ComponentPosition_indexes_DimensionComponent @ddsc:ComponentPositionShape +;
	}

# class DimensionalDataSet
# based on the UML class CDIF::DDSC::Classes::DimensionalDataSet
ddsc:DimensionalDataSetShape CLOSED {
	a [ddsc:DimensionalDataSet];
	ddsc:DimensionalDataSet-name	@ddsc:ObjectNameShape;
	ddsc:DimensionalDataSet-physicalFileName	xsd:string;
	^ddsc:LogicalRecord_organizes_DimensionalDataSet @ddsc:LogicalRecordShape +;
	}

# class DimensionalDataStructure
# based on the UML class CDIF::DDSC::Classes::DimensionalDataStructure
ddsc:DimensionalDataStructureShape CLOSED {
	a [ddsc:DimensionalDataStructure];
	ddsc:DimensionalDataStructure_has_IdentifierComponent	@ddsc:IdentifierComponentShape +;
	
	ddsc:DimensionalDataStructure_has_AttributeComponent	@ddsc:AttributeComponentShape +;
	
	ddsc:DimensionalDataStructure_has_MeasureComponent	@ddsc:MeasureComponentShape +;
	
	ddsc:DimensionalDataStructure_has_ComponentPosition	@ddsc:ComponentPositionShape +;
	
	}

# class IdentifierComponent
# based on the UML class CDIF::DDSC::Classes::IdentifierComponent
ddsc:IdentifierComponentShape CLOSED {
	a [ddsc:IdentifierComponent];
	^ddsc:WideDataStructure_has_IdentifierComponent @ddsc:WideDataStructureShape ;
	^ddsc:LongDataStructure_has_IdentifierComponent @ddsc:LongDataStructureShape ;
	^ddsc:DimensionalDataStructure_has_IdentifierComponent @ddsc:DimensionalDataStructureShape ;
	ddsc:IdentifierComponent_isDefinedBy_InstanceVariable	@ddsc:InstanceVariableShape ;
	
	^ddsc:PrimaryKeyComponent_correspondsTo_IdentifierComponent @ddsc:PrimaryKeyComponentShape ;
	}

# class InstanceVariable
# based on the UML class CDIF::DDSC::Classes::InstanceVariable
ddsc:InstanceVariableShape CLOSED {
	a [ddsc:InstanceVariable];
	ddsc:InstanceVariable-definition	@ddsc:InternationalStringShape;
	ddsc:InstanceVariable-describedUnitOfMeasure	@ddsc:ControlledVocabularyEntryShape;
	ddsc:InstanceVariable-name	@ddsc:ObjectNameShape;
	ddsc:InstanceVariable-unitOfMeasureKind	@ddsc:ControlledVocabularyEntryShape;
	^ddsc:LogicalRecord_has_InstanceVariable @ddsc:LogicalRecordShape +;
	ddsc:InstanceVariable_measures_Population	@ddsc:PopulationShape +;
	
	ddsc:InstanceVariable_takesSubstantiveValuesFrom_SubstantiveValueDomain	@ddsc:SubstantiveValueDomainShape ;
	
	ddsc:InstanceVariable_takesSentinelValuesFrom_SentinelValueDomain	@ddsc:SentinelValueDomainShape +;
	
	^ddsc:Descriptor_identifies_InstanceVariable @ddsc:DescriptorShape +;
	^ddsc:IdentifierComponent_isDefinedBy_InstanceVariable @ddsc:IdentifierComponentShape ;
	^ddsc:MeasureComponent_isDefinedBy_InstanceVariable @ddsc:MeasureComponentShape ;
	^ddsc:AttributeComponent_isDefinedBy_InstanceVariable @ddsc:AttributeComponentShape ;
	^ddsc:DimensionComponent_isDefinedBy_InstanceVariable @ddsc:DimensionComponentShape ;
	^ddsc:ValueMapping_formats_InstanceVariable @ddsc:ValueMappingShape ;
	}

# class LogicalRecord
# based on the UML class CDIF::DDSC::Classes::LogicalRecord
ddsc:LogicalRecordShape CLOSED {
	a [ddsc:LogicalRecord];
	^ddsc:DataStore_has_LogicalRecord @ddsc:DataStoreShape +;
	ddsc:LogicalRecord_organizes_WideDataSet	@ddsc:WideDataSetShape +;
	
	ddsc:LogicalRecord_organizes_LongDataSet	@ddsc:LongDataSetShape +;
	
	ddsc:LogicalRecord_organizes_DimensionalDataSet	@ddsc:DimensionalDataSetShape +;
	
	ddsc:LogicalRecord_has_InstanceVariable	@ddsc:InstanceVariableShape +;
	
	ddsc:LogicalRecord_isDefinedBy_UnitType	@ddsc:UnitTypeShape +;
	
	ddsc:LogicalRecord_isDefinedBy_Universe	@ddsc:UniverseShape +;
	
	ddsc:LogicalRecord_isDefinedBy_Population	@ddsc:PopulationShape +;
	
	^ddsc:PhysicalSegmentLayout_formats_LogicalRecord @ddsc:PhysicalSegmentLayoutShape +;
	}

# class LongDataSet
# based on the UML class CDIF::DDSC::Classes::LongDataSet
ddsc:LongDataSetShape CLOSED {
	a [ddsc:LongDataSet];
	ddsc:LongDataSet-name	@ddsc:ObjectNameShape;
	ddsc:LongDataSet-physicalFileName	xsd:string;
	^ddsc:LogicalRecord_organizes_LongDataSet @ddsc:LogicalRecordShape +;
	}

